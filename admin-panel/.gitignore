# Build output and installed dependencies — regenerated by `npm ci` and
# `npm run build` (and by the Dockerfile's builder stage). Never
# committed, the same way target/ and node artifacts are excluded for
# every other service here.
node_modules/
.next/
next-env.d.ts

# Local environment overrides. The panel's real configuration comes from
# the Deployment's env block; a committed .env would be a second,
# invisible source of truth.
.env
.env.*
tsconfig.tsbuildinfo
